# AI story generation — free key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Supabase (server-only; used for shareable story links + feedback).
# The app degrades gracefully without these: sharing/feedback simply hide.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Optional: canonical site URL for metadata/share links (defaults to the
# Vercel production URL when deployed there).
# NEXT_PUBLIC_SITE_URL=https://islamicsleeps.example.com
